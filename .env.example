# Copia este archivo a .env y llena los valores reales.
# .env NUNCA se sube al repo (ya debe estar en .gitignore).

# Ya no se usa Google Custom Search API (cerrada para clientes nuevos).
# El scraping ahora es directo a google.com/search, sin API key.

# Token para proteger los endpoints /admin/* (refresh, moderación)
# Genera uno random, ej: openssl rand -hex 32
ADMIN_TOKEN=

# Puerto del servidor
PORT=4000

# Dominios permitidos por CORS (separados por coma)
ALLOWED_ORIGINS=https://edmaverick.manglar.fun,http://localhost:5173
